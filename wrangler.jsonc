{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nova-proxy1",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "1f1aaaeb-2495-487a-a522-e257e4498ff0","database_name": "nova-proxy3" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "d5a3bd82c8d24f6ab9f65803466fcb59" }
  ],
  "vars": {
    "PAGES_URL": "https://nova-panel.github.io"
  },
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
